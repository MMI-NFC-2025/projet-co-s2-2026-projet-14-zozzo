---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Accueil">

  <div class="flex flex-col items-center px-5 py-8 sm:px-8">

    <!-- ── Avatar ──────────────────────────────────────────────────── -->
    <div
      id="home-avatar-wrapper"
      class="mb-4 flex h-24 w-24 items-center justify-center overflow-hidden rounded-full bg-zozzo-beige shadow-md sm:h-28 sm:w-28"
    >
      <img id="home-avatar-img" src="" alt="Avatar" class="hidden h-full w-full object-cover" />
      <span id="home-avatar-initiale" class="font-title text-3xl text-zozzo-orange sm:text-4xl">?</span>
    </div>

    <!-- ── Bonjour ─────────────────────────────────────────────────── -->
    <h1 id="home-greeting" class="mb-1 font-title text-2xl text-zozzo-text sm:text-3xl">
      Bonjour !
    </h1>

    <!-- ── Niveau ──────────────────────────────────────────────────── -->
    <p id="home-niveau" class="mb-8 text-sm font-medium text-gray-400">Niveau —</p>

    <!-- ── Cartes de navigation ────────────────────────────────────── -->
    <div class="w-full max-w-md space-y-3">

      <a href="/app/lecons"
        class="flex w-full items-center gap-4 rounded-3xl px-4 py-4 shadow-sm transition active:scale-[0.98]"
        style="background-color:#224ed1;">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-3xl">📚</span>
        <span class="font-subtitle text-xl font-semibold text-white">Leçons</span>
        <svg class="ml-auto h-5 w-5 shrink-0 text-white/70" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke-linecap="round"/></svg>
      </a>

      <a href="/app/histoires"
        class="flex w-full items-center gap-4 rounded-3xl px-4 py-4 shadow-sm transition active:scale-[0.98]"
        style="background-color:#f26748;">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-3xl">📖</span>
        <span class="font-subtitle text-xl font-semibold text-white">Histoires</span>
        <svg class="ml-auto h-5 w-5 shrink-0 text-white/70" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke-linecap="round"/></svg>
      </a>

      <a href="/app/mini-jeux"
        class="flex w-full items-center gap-4 rounded-3xl px-4 py-4 shadow-sm transition active:scale-[0.98]"
        style="background-color:#f3e63f;">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-black/10 text-3xl">🎮</span>
        <span class="font-subtitle text-xl font-semibold text-zozzo-text">Mini-jeux</span>
        <svg class="ml-auto h-5 w-5 shrink-0 text-zozzo-text/50" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke-linecap="round"/></svg>
      </a>

      <a href="/app/dictionnaire"
        class="flex w-full items-center gap-4 rounded-3xl px-4 py-4 shadow-sm transition active:scale-[0.98]"
        style="background-color:#84a5f2;">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-3xl">🔤</span>
        <span class="font-subtitle text-xl font-semibold text-white">Dictionnaire</span>
        <svg class="ml-auto h-5 w-5 shrink-0 text-white/70" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke-linecap="round"/></svg>
      </a>

    </div>
  </div>

  <script>
    // @ts-nocheck
    import { getCurrentUserWithAvatar, getAvatarImageUrl } from "../../lib/pocketbase.js";

    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    }

    (async () => {
      try {
        const user = await getCurrentUserWithAvatar();
        if (!user) return;

        const pseudo = user.pseudo || "";
        setText("home-greeting", pseudo ? `Bonjour ${pseudo} !` : "Bonjour !");
        setText("home-niveau", `Niveau ${user.niveau ?? 1}`);

        const url = getAvatarImageUrl(user.expand?.avatar);
        const img = document.getElementById("home-avatar-img");
        const initiale = document.getElementById("home-avatar-initiale");

        if (url && img) {
          img.src = url;
          img.classList.remove("hidden");
          if (initiale) initiale.classList.add("hidden");
        } else if (pseudo && initiale) {
          initiale.textContent = pseudo[0].toUpperCase();
        }
      } catch (e) {
        console.error("[ZOZZO] Erreur chargement accueil :", e);
      }
    })();
  </script>

</AppLayout>
