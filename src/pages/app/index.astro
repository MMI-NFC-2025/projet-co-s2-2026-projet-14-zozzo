---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Mon espace">

  <div class="container-zozzo py-10">

    <!-- Message de bienvenue (rempli en JS) -->
    <div class="mb-10">
      <h1 id="welcome-title" class="font-title text-3xl text-zozzo-text sm:text-4xl">
        Bonjour ! 👋
      </h1>
      <p class="mt-2 text-sm text-gray-500 sm:text-base">
        Prêt·e à apprendre la langue des signes aujourd'hui ?
      </p>
    </div>

    <!-- Statistiques rapides -->
    <div class="mb-10 grid grid-cols-3 gap-4 sm:gap-6">

      <div class="flex flex-col items-center rounded-2xl bg-zozzo-beige p-4 text-center sm:p-6">
        <span id="stat-niveau" class="font-title text-3xl font-semibold text-zozzo-orange sm:text-4xl">—</span>
        <span class="mt-1 text-xs font-medium text-gray-500 sm:text-sm">Niveau</span>
      </div>

      <div class="flex flex-col items-center rounded-2xl bg-zozzo-beige p-4 text-center sm:p-6">
        <span id="stat-vies" class="font-title text-3xl font-semibold text-zozzo-orange sm:text-4xl">—</span>
        <span class="mt-1 text-xs font-medium text-gray-500 sm:text-sm">Vies</span>
      </div>

      <div class="flex flex-col items-center rounded-2xl bg-zozzo-beige p-4 text-center sm:p-6">
        <span id="stat-xp" class="font-title text-3xl font-semibold text-zozzo-orange sm:text-4xl">—</span>
        <span class="mt-1 text-xs font-medium text-gray-500 sm:text-sm">XP</span>
      </div>

    </div>

    <!-- Navigation principale de l'app -->
    <h2 class="mb-5 font-subtitle text-xl text-zozzo-text sm:text-2xl">Que veux-tu faire ?</h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

      <a href="/app/lecons" class="group flex items-center gap-4 rounded-2xl border-2 border-transparent bg-white p-5 shadow-sm transition hover:border-zozzo-orange hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-zozzo-beige text-2xl">📚</div>
        <div>
          <p class="font-semibold text-zozzo-text">Leçons</p>
          <p class="text-xs text-gray-400">Apprendre par thème</p>
        </div>
      </a>

      <a href="/app/dictionnaire" class="group flex items-center gap-4 rounded-2xl border-2 border-transparent bg-white p-5 shadow-sm transition hover:border-zozzo-orange hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-zozzo-bleu-clair/30 text-2xl">🔤</div>
        <div>
          <p class="font-semibold text-zozzo-text">Dictionnaire</p>
          <p class="text-xs text-gray-400">Chercher un signe</p>
        </div>
      </a>

      <a href="/app/histoires" class="group flex items-center gap-4 rounded-2xl border-2 border-transparent bg-white p-5 shadow-sm transition hover:border-zozzo-orange hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-zozzo-jaune/50 text-2xl">📖</div>
        <div>
          <p class="font-semibold text-zozzo-text">Histoires</p>
          <p class="text-xs text-gray-400">Lire et signer</p>
        </div>
      </a>

      <a href="/app/mini-jeux" class="group flex items-center gap-4 rounded-2xl border-2 border-transparent bg-white p-5 shadow-sm transition hover:border-zozzo-orange hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-zozzo-orange/20 text-2xl">🎮</div>
        <div>
          <p class="font-semibold text-zozzo-text">Mini-jeux</p>
          <p class="text-xs text-gray-400">Jouer et progresser</p>
        </div>
      </a>

      <a href="/app/profil" class="group flex items-center gap-4 rounded-2xl border-2 border-transparent bg-white p-5 shadow-sm transition hover:border-zozzo-orange hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gray-100 text-2xl">👤</div>
        <div>
          <p class="font-semibold text-zozzo-text">Mon profil</p>
          <p class="text-xs text-gray-400">Voir mes stats</p>
        </div>
      </a>

      <a href="/app/premium" class="group flex items-center gap-4 rounded-2xl border-2 border-transparent bg-white p-5 shadow-sm transition hover:border-zozzo-jaune hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-zozzo-jaune/50 text-2xl">⭐</div>
        <div>
          <p class="font-semibold text-zozzo-text">Premium</p>
          <p class="text-xs text-gray-400">Débloquer tout</p>
        </div>
      </a>

    </div>

  </div>

  <script>
    import { getCurrentUser } from "../../lib/pocketbase.js";

    const user = getCurrentUser();
    if (user) {
      // Mettre à jour le message de bienvenue
      const titleEl = document.getElementById("welcome-title");
      if (titleEl) titleEl.textContent = `Bonjour ${user.pseudo || ""} ! 👋`;

      // Remplir les stats
      document.getElementById("stat-niveau").textContent = user.niveau ?? "1";
      document.getElementById("stat-vies").textContent = "❤️".repeat(user.vies ?? 3);
      document.getElementById("stat-xp").textContent = (user.experience ?? 0) + " XP";
    }
  </script>

</AppLayout>
