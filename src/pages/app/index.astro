---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Accueil">

  <!-- Mobile : flex-col | Desktop sm+ : flex-row 2 colonnes -->
  <div class="flex flex-col items-center gap-6 px-5 py-8 sm:h-[calc(100dvh-4rem)] sm:flex-row sm:items-center sm:gap-4 sm:px-10 sm:py-0">

    <!-- ── Avatar ──────────────────────────────────────────────── -->
    <div class="flex w-full items-center justify-center sm:flex-1">
      <div
        id="home-avatar-circle"
        class="flex h-36 w-36 items-center justify-center overflow-hidden rounded-full sm:h-52 sm:w-52"
        style="background-color:#c4b5fd;"
      >
        <img id="home-avatar-img" src="" alt="Avatar" class="hidden h-full w-full object-contain p-2" />
        <span id="home-avatar-initiale" class="font-title text-5xl font-bold text-white sm:text-6xl">?</span>
      </div>
    </div>

    <!-- ── Séparateur jaune (caché sur mobile) ─────────────────── -->
    <div class="hidden h-52 w-1 self-center rounded-full sm:block" style="background-color:var(--color-zozzo-jaune);"></div>

    <!-- ── Cartes de navigation ────────────────────────────────── -->
    <div class="flex w-full flex-col gap-3 sm:flex-1">

      <!-- Leçons -->
      <a
        href="/app/lecons"
        class="relative flex items-center justify-between overflow-hidden rounded-2xl px-5 py-3.5 shadow-sm transition active:scale-95"
        style="background-color:var(--color-zozzo-bleu-clair);"
      >
        <img src="/images/shapes/bg-lecon.png" alt="" aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover" />
        <span class="relative z-10 font-subtitle text-lg font-semibold text-white">Leçons</span>
        <svg class="relative z-10 h-12 w-12 shrink-0" fill="currentColor" viewBox="0 0 24 24" style="color:var(--color-zozzo-bleu-fonce);" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </a>

      <!-- Dictionnaire — texte + flèche jaune -->
      <a
        href="/app/dictionnaire"
        class="relative flex items-center justify-between overflow-hidden rounded-2xl px-5 py-3.5 shadow-sm transition active:scale-95"
        style="background-color:var(--color-zozzo-bleu-fonce);"
      >
        <img src="/images/shapes/bg-dico.png" alt="" aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover" />
        <span class="relative z-10 font-subtitle text-lg font-semibold" style="color:var(--color-zozzo-jaune);">Dictionnaire</span>
        <svg class="relative z-10 h-12 w-12 shrink-0" fill="currentColor" viewBox="0 0 24 24" style="color:var(--color-zozzo-jaune);" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </a>

      <!-- Histoires — texte + flèche blanc -->
      <a
        href="/app/histoires"
        class="relative flex items-center justify-between overflow-hidden rounded-2xl px-5 py-3.5 shadow-sm transition active:scale-95"
        style="background-color:var(--color-zozzo-orange);"
      >
        <img src="/images/shapes/bg-histoire.png" alt="" aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover" />
        <span class="relative z-10 font-subtitle text-lg font-semibold text-white">Histoires</span>
        <svg class="relative z-10 h-12 w-12 shrink-0 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </a>

      <!-- Mini-jeux — texte + flèche bleu foncé -->
      <a
        href="/app/mini-jeux"
        class="relative flex items-center justify-between overflow-hidden rounded-2xl px-5 py-3.5 shadow-sm transition active:scale-95"
        style="background-color:var(--color-zozzo-jaune);"
      >
        <img src="/images/shapes/bg-minijeux.png" alt="" aria-hidden="true"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover" />
        <span class="relative z-10 font-subtitle text-lg font-semibold" style="color:var(--color-zozzo-bleu-fonce);">Mini-jeux</span>
        <svg class="relative z-10 h-12 w-12 shrink-0" fill="currentColor" viewBox="0 0 24 24" style="color:var(--color-zozzo-bleu-fonce);" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </a>

    </div>
  </div>

  <script>
    // @ts-nocheck
    import { getCurrentUserWithAvatar, getAvatarImageUrl } from "../../lib/backend.js";

    (async () => {
      try {
        const user = await getCurrentUserWithAvatar();
        if (!user) return;

        const url = getAvatarImageUrl(user.expand?.avatar);
        const img = document.getElementById("home-avatar-img");
        const initiale = document.getElementById("home-avatar-initiale");

        if (url && img) {
          img.src = url;
          img.classList.remove("hidden");
          if (initiale) initiale.classList.add("hidden");
        } else if (initiale) {
          const pseudo = user.pseudo || "?";
          initiale.textContent = pseudo[0].toUpperCase();
        }
      } catch (e) {
        console.error("[ZOZZO] Erreur chargement accueil :", e);
      }
    })();
  </script>

</AppLayout>
