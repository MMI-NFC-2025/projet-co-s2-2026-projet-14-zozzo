---
// @ts-nocheck
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Profil" showBack={true} backHref="/app" pageTitle="Profil">

  <!-- ══ MODAL : CHOISIR UN AVATAR ══════════════════════════════════ -->
  <div
    id="avatar-modal"
    aria-hidden="true"
    class="fixed inset-0 z-[70] bg-white flex flex-col translate-y-full transition-transform duration-300 ease-in-out"
  >
    <div class="flex items-center gap-4 border-b border-gray-100 px-5 py-4 bg-zozzo-beige">
      <button
        id="close-avatar-modal"
        aria-label="Fermer"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-zozzo-text transition hover:bg-white"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <h2 class="font-title text-lg font-semibold text-zozzo-text">Choisir un avatar</h2>
    </div>

    <div class="flex-1 overflow-y-auto p-5">
      <div id="modal-loading" class="py-8 text-center text-sm text-gray-400">Chargement…</div>
      <div id="modal-grid" class="hidden grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6"></div>
    </div>

    <div class="border-t border-gray-100 p-5">
      <p id="modal-success" class="mb-3 hidden text-center text-sm font-medium text-green-600">✓ Avatar mis à jour !</p>
      <p id="modal-error" class="mb-3 hidden text-center text-sm text-red-500">Impossible de sauvegarder. Réessaie.</p>
      <button
        id="save-avatar-btn"
        disabled
        class="w-full rounded-full bg-zozzo-orange py-3.5 text-base font-semibold text-white transition hover:opacity-90 disabled:opacity-40"
      >
        Sauvegarder
      </button>
    </div>
  </div>

  <!-- ══ PAGE PROFIL ════════════════════════════════════════════════ -->
  <div class="container-zozzo py-8">

    <!-- ── Avatar + pseudo ────────────────────────────────────────── -->
    <div class="mb-8 flex flex-col items-center gap-3 text-center">
      <div class="flex h-28 w-28 items-center justify-center overflow-hidden rounded-full bg-zozzo-beige shadow-md">
        <img id="profil-avatar-img" src="" alt="Avatar" class="hidden h-full w-full object-contain p-2" />
        <span id="profil-avatar-initiale" class="font-title text-4xl text-zozzo-orange">?</span>
      </div>
      <p id="profil-pseudo-display" class="font-title text-2xl text-zozzo-text">—</p>
      <button
        id="change-avatar-btn"
        class="rounded-full border-2 border-zozzo-bleu-clair px-5 py-1.5 text-sm font-semibold text-zozzo-bleu-fonce transition hover:bg-zozzo-bleu-clair hover:text-white"
      >
        Changer mon avatar
      </button>
    </div>

    <!-- ── Informations ───────────────────────────────────────────── -->
    <div class="mb-5 rounded-3xl bg-white p-5 shadow-sm sm:p-6">
      <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-400">Informations</h2>
      <ul class="divide-y divide-gray-100">
        {[
          { label: "Pseudo",      id: "info-pseudo" },
          { label: "Email",       id: "info-email" },
          { label: "Âge",         id: "info-age" },
          { label: "Niveau",      id: "info-niveau" },
          { label: "Abonnement",  id: "info-abo" },
        ].map(row => (
          <li class="flex items-center justify-between py-3">
            <span class="text-sm font-medium text-gray-500">{row.label}</span>
            <span id={row.id} class="text-sm font-semibold text-zozzo-text">—</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- ── Bouton modifier ─────────────────────────────────────────── -->
    <button
      id="toggle-edit-btn"
      class="mb-4 w-full rounded-full border-2 border-zozzo-orange py-3 text-sm font-semibold text-zozzo-orange transition hover:bg-zozzo-orange hover:text-white"
    >
      Modifier mes informations
    </button>

    <!-- ── Formulaire modification (caché par défaut) ──────────────── -->
    <div id="edit-section" class="hidden mb-5 rounded-3xl bg-white p-5 shadow-sm sm:p-6">
      <h2 class="mb-5 font-subtitle text-base font-semibold text-zozzo-text">Modifier mes informations</h2>

      <div id="edit-success" class="mb-4 hidden rounded-2xl bg-green-50 px-4 py-3 text-sm text-green-700">✓ Profil mis à jour !</div>
      <div id="edit-error" class="mb-4 hidden rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-600"></div>

      <form id="edit-form" class="flex flex-col gap-4" novalidate>
        <div>
          <label for="edit-pseudo" class="mb-1.5 block text-sm font-medium text-zozzo-text">Pseudo</label>
          <input type="text" id="edit-pseudo" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none transition focus:border-zozzo-orange" />
        </div>
        <div>
          <label for="edit-email" class="mb-1.5 block text-sm font-medium text-zozzo-text">Email</label>
          <input type="email" id="edit-email" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none transition focus:border-zozzo-orange" />
        </div>
        <div>
          <label for="edit-age" class="mb-1.5 block text-sm font-medium text-zozzo-text">Âge</label>
          <input type="number" id="edit-age" min="4" max="18" class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm outline-none transition focus:border-zozzo-orange" />
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" id="cancel-edit-btn" class="flex-1 rounded-full border-2 border-gray-200 py-3 text-sm font-semibold text-gray-500 transition hover:border-gray-400">
            Annuler
          </button>
          <button id="save-edit-btn" type="submit" class="flex-1 rounded-full bg-zozzo-orange py-3 text-sm font-semibold text-white transition hover:opacity-90">
            Enregistrer
          </button>
        </div>
      </form>
    </div>

    <!-- ── Déconnexion ─────────────────────────────────────────────── -->
    <button
      id="logout-btn"
      class="w-full rounded-full py-3 text-sm font-semibold text-gray-400 transition hover:text-red-500"
    >
      Se déconnecter
    </button>

  </div>

  <script>
    // @ts-nocheck
    import {
      getCurrentUserWithAvatar,
      getAvatars,
      getAvatarImageUrl,
      updateUserAvatar,
      updateUserProfile,
      logout,
    } from "../../lib/backend.js";

    let currentUser: any = null;
    let selectedAvatarId: string | null = null;

    function setText(id: string, val: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    }

    // ── Chargement du profil ─────────────────────────────────────────
    async function loadProfile() {
      currentUser = await getCurrentUserWithAvatar() as any;
      if (!currentUser) return;

      const pseudo = currentUser.pseudo || "—";
      afficherAvatar(currentUser.expand?.avatar);
      setText("profil-pseudo-display", pseudo);
      setText("info-pseudo",  pseudo);
      setText("info-email",   currentUser.email || "—");
      setText("info-age",     currentUser.age ? `${currentUser.age} ans` : "—");
      setText("info-niveau",  `Niveau ${currentUser.niveau ?? 1}`);
      setText("info-abo",     currentUser.abonnement_actif ? "⭐ Premium" : "Gratuit");

      // Pré-remplir le formulaire
      const inp = (id: string) => document.getElementById(id) as HTMLInputElement | null;
      const ep = inp("edit-pseudo"); if (ep) ep.value = currentUser.pseudo || "";
      const ee = inp("edit-email");  if (ee) ee.value = currentUser.email  || "";
      const ea = inp("edit-age");    if (ea) ea.value = currentUser.age    ?? "";
    }

    function afficherAvatar(avatarRecord: any) {
      const img      = document.getElementById("profil-avatar-img")      as HTMLImageElement | null;
      const initiale = document.getElementById("profil-avatar-initiale");
      const url = getAvatarImageUrl(avatarRecord);

      if (url && img) {
        img.src = url;
        img.classList.remove("hidden");
        initiale?.classList.add("hidden");
      } else if (initiale) {
        const pseudo = currentUser?.pseudo || "?";
        initiale.textContent = pseudo[0].toUpperCase();
        img?.classList.add("hidden");
        initiale.classList.remove("hidden");
      }
    }

    loadProfile();

    // ── Modal avatar ─────────────────────────────────────────────────
    const modal         = document.getElementById("avatar-modal")     as HTMLElement;
    const saveAvatarBtn = document.getElementById("save-avatar-btn")  as HTMLButtonElement;
    let modalLoaded     = false;
    let loadedAvatars: any[] = []; // garde les records en mémoire pour affichage immédiat

    const openModal  = () => { modal.style.transform = "translateY(0)"; modal.setAttribute("aria-hidden","false"); document.body.style.overflow = "hidden"; if (!modalLoaded) loadAvatarGrid(); };
    const closeModal = () => { modal.style.transform = "translateY(100%)"; modal.setAttribute("aria-hidden","true"); document.body.style.overflow = ""; };

    document.getElementById("change-avatar-btn")?.addEventListener("click", openModal);
    document.getElementById("close-avatar-modal")?.addEventListener("click", closeModal);

    async function loadAvatarGrid() {
      const loading = document.getElementById("modal-loading") as HTMLElement;
      const grid    = document.getElementById("modal-grid")    as HTMLElement;

      try {
        const avatars = await getAvatars() as any[];
        loadedAvatars = avatars; // mémorise pour l'affichage après sauvegarde
        loading.style.display = "none";
        grid.classList.remove("hidden");
        grid.classList.add("grid");
        modalLoaded = true;

        const currentAvatarId = currentUser?.avatar ?? null;
        if (currentAvatarId) {
          selectedAvatarId = currentAvatarId;
          saveAvatarBtn.disabled = false;
        }

        avatars.forEach((avatar) => {
          const imgUrl    = getAvatarImageUrl(avatar) ?? "";
          const isSelected = avatar.id === currentAvatarId;

          const btn = document.createElement("button");
          btn.type = "button";
          btn.dataset.id = avatar.id;
          btn.className = [
            "avatar-opt relative rounded-2xl border-2 p-1",
            "transition-all duration-200 hover:scale-105 focus:outline-none",
            isSelected ? "border-zozzo-bleu-fonce scale-105" : "border-transparent hover:border-zozzo-bleu-clair",
          ].join(" ");

          btn.innerHTML = `
            <img src="${imgUrl}" alt="${avatar.nom}" class="w-full aspect-square rounded-xl object-cover" loading="lazy"/>
            <span class="check absolute inset-0 items-center justify-center rounded-2xl bg-zozzo-bleu-fonce/15 ${isSelected ? "flex" : "hidden"}">
              <svg viewBox="0 0 24 24" class="h-7 w-7 text-zozzo-bleu-fonce" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 13l4 4L19 7"/></svg>
            </span>`;

          btn.addEventListener("click", () => {
            document.querySelectorAll<HTMLElement>(".avatar-opt").forEach(b => {
              b.classList.remove("border-zozzo-bleu-fonce", "scale-105");
              b.classList.add("border-transparent");
              b.querySelector(".check")?.classList.replace("flex", "hidden");
            });
            btn.classList.remove("border-transparent");
            btn.classList.add("border-zozzo-bleu-fonce", "scale-105");
            btn.querySelector(".check")?.classList.replace("hidden", "flex");
            selectedAvatarId = avatar.id;
            saveAvatarBtn.disabled = false;
          });

          grid.appendChild(btn);
        });
      } catch {
        loading.textContent = "Impossible de charger les personnages.";
      }
    }

    saveAvatarBtn.addEventListener("click", async () => {
      if (!selectedAvatarId || !currentUser) return;
      const successEl = document.getElementById("modal-success") as HTMLElement;
      const errorEl   = document.getElementById("modal-error")   as HTMLElement;
      successEl.classList.add("hidden");
      errorEl.classList.add("hidden");
      saveAvatarBtn.disabled = true;
      saveAvatarBtn.textContent = "Sauvegarde…";

      try {
        await updateUserAvatar(currentUser.id, selectedAvatarId);

        // Afficher directement depuis la liste déjà chargée — pas de re-fetch risqué
        const newAvatarRecord = loadedAvatars.find((a) => a.id === selectedAvatarId);
        if (newAvatarRecord) {
          currentUser.avatar = selectedAvatarId;
          if (!currentUser.expand) currentUser.expand = {};
          currentUser.expand.avatar = newAvatarRecord;
          afficherAvatar(newAvatarRecord);
        }

        successEl.classList.remove("hidden");
        saveAvatarBtn.textContent = "Sauvegarder";
        saveAvatarBtn.disabled = false;
        setTimeout(() => { successEl.classList.add("hidden"); closeModal(); }, 1500);
      } catch {
        errorEl.classList.remove("hidden");
        saveAvatarBtn.textContent = "Sauvegarder";
        saveAvatarBtn.disabled = false;
      }
    });

    // ── Formulaire modification ──────────────────────────────────────
    const editSection   = document.getElementById("edit-section")    as HTMLElement;
    const toggleEditBtn = document.getElementById("toggle-edit-btn") as HTMLButtonElement;
    const editSuccess   = document.getElementById("edit-success")    as HTMLElement;
    const editError     = document.getElementById("edit-error")      as HTMLElement;
    const saveEditBtn   = document.getElementById("save-edit-btn")   as HTMLButtonElement;

    toggleEditBtn.addEventListener("click", () => {
      const isOpen = !editSection.classList.contains("hidden");
      editSection.classList.toggle("hidden", isOpen);
      toggleEditBtn.textContent = isOpen ? "Modifier mes informations" : "Fermer le formulaire";
    });

    document.getElementById("cancel-edit-btn")?.addEventListener("click", () => {
      editSection.classList.add("hidden");
      toggleEditBtn.textContent = "Modifier mes informations";
    });

    (document.getElementById("edit-form") as HTMLFormElement).addEventListener("submit", async (e) => {
      e.preventDefault();
      editSuccess.classList.add("hidden");
      editError.classList.add("hidden");

      const g = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
      const pseudo = g("edit-pseudo").trim();
      const email  = g("edit-email").trim();
      const age    = g("edit-age");

      saveEditBtn.disabled = true;
      saveEditBtn.textContent = "Enregistrement…";

      try {
        await updateUserProfile({ pseudo, email, age });
        currentUser.pseudo = pseudo;
        currentUser.email  = email;
        currentUser.age    = parseInt(age);

        setText("profil-pseudo-display", pseudo || "—");
        setText("info-pseudo", pseudo || "—");
        setText("info-email",  email  || "—");
        setText("info-age",    age    ? `${age} ans` : "—");

        editSuccess.classList.remove("hidden");
        setTimeout(() => editSuccess.classList.add("hidden"), 3000);
      } catch (err: any) {
        const d = err?.data?.data;
        editError.textContent = d?.email?.message
          ? "Cet email est déjà utilisé."
          : d?.pseudo?.message
            ? "Ce pseudo est déjà pris."
            : "Impossible de mettre à jour. Vérifie les informations.";
        editError.classList.remove("hidden");
      } finally {
        saveEditBtn.disabled = false;
        saveEditBtn.textContent = "Enregistrer";
      }
    });

    // ── Déconnexion ──────────────────────────────────────────────────
    document.getElementById("logout-btn")?.addEventListener("click", () => {
      logout();
      window.location.href = "/";
    });
  </script>

</AppLayout>
