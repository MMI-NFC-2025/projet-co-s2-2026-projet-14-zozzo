---
// @ts-nocheck
import AppLayout from "../../../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Reconsti" showBack={true} backHref="/app/mini-jeux/reconsti" pageTitle="Reconsti">

  <!-- CHARGEMENT -->
  <div id="ls" class="flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center gap-3 bg-[#fff9f7]">
    <div class="h-10 w-10 animate-spin rounded-full border-4 border-t-transparent"
      style="border-color:var(--color-zozzo-bleu-fonce) transparent #224ed1 #224ed1;"></div>
    <p class="font-subtitle text-sm text-gray-400">Préparation…</p>
    <p id="err-msg" class="hidden px-6 text-center text-xs text-red-400"></p>
  </div>

  <!-- JEU -->
  <div id="gs" class="hidden flex-col bg-white" style="min-height:calc(100dvh - 4rem);">

    <!-- Timer + score -->
    <div class="flex items-center justify-between px-5 pt-4 pb-1 shrink-0">
      <p id="prog" class="font-subtitle text-sm font-medium text-gray-400">1 / ?</p>
      <span id="timer" class="font-title text-sm text-gray-400">0 s</span>
    </div>

    <!-- Titre de la phrase -->
    <div class="shrink-0 px-5 pt-2 pb-2 text-center">
      <p class="font-subtitle text-xs font-medium uppercase tracking-wide text-gray-400">Phrase à reconstituer</p>
      <h2 id="phrase-titre" class="mt-2 font-title text-xl text-zozzo-text sm:text-2xl">…</h2>
    </div>

    <!-- Zone de réponse -->
    <div class="shrink-0 px-5 pb-2 min-h-[110px] flex items-center justify-center">
      <div id="answer-zone" class="flex flex-wrap justify-center gap-2 w-full"></div>
    </div>

    <!-- Feedback ZOZZO (caché) -->
    <div id="zozzo-fb" class="hidden shrink-0 items-center justify-center py-1">
      <img id="zozzo-fb-img" src="" alt="" class="h-20 w-auto rc-bounce" />
    </div>

    <!-- Séparateur orange -->
    <div class="mx-5 mb-2 shrink-0 rounded-full" style="height:3px;background:var(--color-zozzo-orange);"></div>

    <!-- Pool des signes — centré, proche du séparateur -->
    <div id="sign-pool" class="shrink-0 flex justify-center gap-3 px-5 pt-3 pb-2 overflow-x-auto" style="flex-wrap:nowrap;"></div>

    <!-- Flèche jaune en bas à droite -->
    <div class="shrink-0 flex items-center justify-end px-5 pb-5 pt-2">
      <button id="validate-btn" class="transition hover:scale-110 active:scale-95">
        <svg viewBox="0 0 60 24" class="h-8 w-16" fill="none">
          <line x1="0" y1="12" x2="50" y2="12" stroke="#f3e63f" stroke-width="4" stroke-linecap="round"/>
          <polyline points="38,3 54,12 38,21" stroke="#f3e63f" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- RÉSULTAT -->
  <div id="rs" class="hidden min-h-[calc(100dvh-4rem)] flex-col items-center justify-center bg-[#fff9f7] px-6 py-8 text-center">
    <h1 class="font-title text-3xl text-zozzo-orange">Résultat</h1>
    <img src="/images/about/zozzo-bon-reponse.png" alt="Zozzo" class="my-4 h-auto w-36" />
    <div class="w-full max-w-xs space-y-3 rounded-3xl border border-gray-100 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <span class="font-subtitle text-sm font-semibold text-zozzo-bleu-fonce">Temps :</span>
        <span id="rt" class="font-title text-xl text-zozzo-text"></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="font-subtitle text-sm font-semibold text-zozzo-bleu-fonce">Score :</span>
        <span id="rs2" class="font-title text-xl text-zozzo-text"></span>
      </div>
    </div>
    <div class="mt-8 flex justify-end w-full max-w-xs pr-2">
      <button id="gc" class="transition hover:scale-110 active:scale-95">
        <svg viewBox="0 0 60 24" class="h-8 w-16" fill="none">
          <line x1="0" y1="12" x2="50" y2="12" stroke="#f3e63f" stroke-width="4" stroke-linecap="round"/>
          <polyline points="38,3 54,12 38,21" stroke="#f3e63f" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <script>
    // @ts-nocheck
    import {
      getJeuBySlug,
      getAllPhrasesJeux,
      getSignesByMots,
      getCurrentUser,
      saveScore,
      pb,
    } from "../../../../lib/backend.js";

    const params  = new URLSearchParams(window.location.search);
    const niveau  = params.get("level") ?? "facile";

    // ── État ──────────────────────────────────────────────────────
    let phrases     = [];
    let phraseIdx   = 0;
    let currentMots = [];      // mots corrects dans l'ordre
    let currentSignes = [];    // signes shufflés pour cette phrase
    let selected    = [];      // signes sélectionnés par l'utilisateur (dans l'ordre)
    let score       = 0, bonnes = 0, mauvaises = 0, elapsed = 0, timerInt = null, jeuId = null;
    let answered    = false;

    // ── DOM ───────────────────────────────────────────────────────
    const $ = id => document.getElementById(id);
    const ls = $("ls"), gs = $("gs"), rs = $("rs");
    const progEl    = $("prog");
    const timerEl   = $("timer");
    const titreEl   = $("phrase-titre");
    const answerZone = $("answer-zone");
    const signPool    = $("sign-pool");
    const zozzoFb     = $("zozzo-fb");
    const zozzoFbImg  = $("zozzo-fb-img");
    const validateBtn = $("validate-btn");

    // ── Timer ─────────────────────────────────────────────────────
    function startTimer() {
      timerInt = setInterval(() => {
        elapsed++;
        const m = Math.floor(elapsed/60), s = elapsed%60;
        timerEl.textContent = m ? `${m}min ${s}s` : `${s} s`;
      }, 1000);
    }

    // ── Créer une carte signe ──────────────────────────────────────
    function createSignCard(signe, className) {
      const card = document.createElement("div");
      card.className   = className;
      card.dataset.mot = signe.mot;
      card.dataset.id  = signe.id;

      // Zone image (prend tout l'espace disponible)
      const mediaWrap = document.createElement("div");
      mediaWrap.style.cssText = "flex:1;width:100%;display:flex;align-items:center;justify-content:center;overflow:hidden;min-height:60px;";

      const videoUrl = signe.video ? pb.files.getURL(signe, signe.video) : null;
      if (videoUrl) {
        const v = document.createElement("video");
        v.src = videoUrl; v.autoplay = true; v.muted = true; v.loop = true; v.playsInline = true;
        v.style.cssText = "width:100%;height:100%;object-fit:contain;max-height:90px;";
        mediaWrap.appendChild(v);
      } else if (signe.image) {
        const img = document.createElement("img");
        img.src = pb.files.getURL(signe, signe.image);
        img.alt = signe.mot;
        img.style.cssText = "width:100%;height:100%;object-fit:contain;max-height:90px;";
        img.onerror = () => { img.style.display = "none"; };
        mediaWrap.appendChild(img);
      }
      // Pas d'image ET pas de vidéo → on n'affiche rien dans la zone média
      // (le mot est affiché en dessous via le label)

      card.appendChild(mediaWrap);

      return card;
    }

    // ── Afficher la phrase ─────────────────────────────────────────
    function afficherPhrase() {
      answered = false;
      selected = [];
      answerZone.innerHTML = "";
      signPool.innerHTML   = "";
      zozzoFb.classList.add("hidden");
      zozzoFb.classList.remove("flex");

      const phrase = phrases[phraseIdx];
      const total  = phrases.length;

      titreEl.textContent = phrase.titre ?? "…";
      progEl.textContent  = `${phraseIdx + 1} / ${total}`;

      // Mélanger les signes
      const shuffled = [...currentSignes].sort(() => Math.random() - 0.5);

      shuffled.forEach((signe, i) => {
        const card = createSignCard(signe, "sign-tile");
        card.dataset.poolIdx = i;
        card.addEventListener("click", () => addToAnswer(card, signe));
        signPool.appendChild(card);
      });
    }

    // ── Ajouter un signe à la réponse ─────────────────────────────
    function addToAnswer(poolCard, signe) {
      if (answered || poolCard.classList.contains("used")) return;

      poolCard.classList.add("used");
      selected.push(signe);

      const ansCard = createSignCard(signe, "answer-tile");
      ansCard.addEventListener("click", () => removeFromAnswer(ansCard, poolCard, signe));
      answerZone.appendChild(ansCard);

      // Auto-valider quand tous les mots sont placés
      if (selected.length === currentMots.length) {
        setTimeout(valider, 300);
      }
    }

    // ── Retirer un signe de la réponse ────────────────────────────
    function removeFromAnswer(ansCard, poolCard, signe) {
      if (answered) return;
      ansCard.remove();
      const idx = selected.findIndex(s => s.id === signe.id && !poolCard.classList.contains("used-check"));
      if (idx !== -1) selected.splice(idx, 1);
      poolCard.classList.remove("used");
    }

    // ── Valider la réponse ────────────────────────────────────────
    function valider() {
      if (answered) return;
      answered = true;

      const userMots    = selected.map(s => s.mot);
      const estCorrect  = userMots.join("|") === currentMots.join("|");

      // Feedback visuel sur les cartes
      answerZone.querySelectorAll(".answer-tile").forEach((card, i) => {
        card.classList.add(estCorrect ? "correct" : "wrong");
        card.style.pointerEvents = "none";
      });

      // ZOZZO
      zozzoFbImg.src = estCorrect
        ? "/images/about/zozzo-bon-reponse.png"
        : "/images/about/mouvaise-reponse.png";
      zozzoFb.classList.remove("hidden");
      zozzoFb.classList.add("flex");

      if (estCorrect) { score++; bonnes++; }
      else { mauvaises++; }

      setTimeout(() => passerSuivant(), estCorrect ? 1500 : 2000);
    }

    // ── Phrase suivante ───────────────────────────────────────────
    async function passerSuivant() {
      phraseIdx++;
      if (phraseIdx < phrases.length) {
        // Charger les signes de la prochaine phrase
        const nextPhrase = phrases[phraseIdx];
        const nextMots   = parseMots(nextPhrase.mots);
        currentMots   = nextMots;
        currentSignes = await getSignesByMots(nextMots);
        afficherPhrase();
      } else {
        afficherResultat();
      }
    }

    // ── Valider manuellement via flèche jaune ─────────────────────
    validateBtn.addEventListener("click", () => {
      if (answered || selected.length === 0) return;
      // Si l'enfant valide avant d'avoir tout placé, on valide quand même
      valider();
    });

    // ── Résultat ──────────────────────────────────────────────────
    async function afficherResultat() {
      clearInterval(timerInt);
      gs.classList.add("hidden");
      rs.classList.remove("hidden"); rs.classList.add("flex");

      const m = Math.floor(elapsed/60), s = elapsed%60;
      $("rt").textContent  = m ? `${m} mins ${s} s` : `${s} s`;
      $("rs2").textContent = `${score} / ${phrases.length} phrases`;

      const user = getCurrentUser();
      if (user && jeuId) {
        const totalMots = phrases.reduce((acc, p) => acc + parseMots(p.mots).length, 0);
        try {
          await saveScore({
            utilisateur: user.id, jeu: jeuId, niveau,
            nombre_mots: totalMots, score, temps_secondes: elapsed,
          });
        } catch(e) { console.warn(e); }
      }

      $("gc").addEventListener("click", () => {
        window.location.href = `/app/mini-jeux/classement?slug=reconsti&level=${niveau}`;
      });
    }

    // ── Parser le champ mots (JSON ou Array) ─────────────────────
    function parseMots(mots) {
      if (Array.isArray(mots)) return mots;
      try { return JSON.parse(mots); } catch { return []; }
    }

    // ── Init ──────────────────────────────────────────────────────
    (async () => {
      try {
        const jeu = await getJeuBySlug("reconsti").catch(() => null);
        jeuId = jeu?.id ?? null;

        // Charger TOUTES les phrases actives de PocketBase
        phrases = await getAllPhrasesJeux();
        if (!phrases.length) throw new Error("Aucune phrase disponible dans PocketBase");

        // Préparer la première phrase
        currentMots   = parseMots(phrases[0].mots);
        currentSignes = await getSignesByMots(currentMots);
        console.log("[Reconsti] Signes chargés :", currentSignes.map(s => `${s.mot} → image:${!!s.image} vidéo:${!!s.video}`));

        ls.classList.add("hidden");
        gs.classList.remove("hidden"); gs.classList.add("flex");

        afficherPhrase();
        startTimer();

      } catch(err) {
        console.error("[ZOZZO] Reconsti:", err);
        $("err-msg").textContent = `Erreur : ${err?.message ?? String(err)}`;
        $("err-msg").classList.remove("hidden");
      }
    })();
  </script>

</AppLayout>
