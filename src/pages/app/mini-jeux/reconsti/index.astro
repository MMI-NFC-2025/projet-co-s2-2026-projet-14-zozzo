---
// @ts-nocheck
import AppLayout from "../../../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Reconsti" showBack={true} backHref="/app/mini-jeux" pageTitle="Reconsti">

  <div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center px-4 py-8">

    <h2 class="mb-8 text-center font-subtitle text-sm font-medium text-gray-600 sm:text-base">
      Choisis le niveau de difficulté
    </h2>

    <div class="grid w-full grid-cols-1 gap-4 px-4 sm:grid-cols-3 sm:px-2 max-w-[min(98vw,700px)]">

      <!-- Facile — gratuit -->
      <div
        onclick="window.location.href='/app/mini-jeux/reconsti/play?level=facile'"
        class="flex cursor-pointer flex-col items-center justify-between rounded-3xl shadow-md transition hover:scale-105 active:scale-95 bg-zozzo-bleu-clair px-[clamp(6px,2vw,16px)] py-[clamp(10px,3.5vw,24px)] min-h-[clamp(160px,45vw,320px)]"
      >
        <p class="text-center font-subtitle font-semibold text-white text-[clamp(0.65rem,2.8vw,1.1rem)]">Une partie rapide</p>
        <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(30px,9vw,80px)] h-[clamp(30px,9vw,80px)] my-2" />
        <p class="font-title font-semibold text-white text-[clamp(0.72rem,3vw,1.2rem)]">Facile</p>
      </div>

      <!-- Moyen — premium -->
      <div
        id="level-moyen"
        class="relative flex flex-col items-center justify-between cursor-pointer overflow-hidden rounded-3xl shadow-md transition hover:scale-105 active:scale-95 bg-zozzo-jaune px-[clamp(6px,2vw,16px)] py-[clamp(10px,3.5vw,24px)] min-h-[clamp(160px,45vw,320px)]"
      >
        <p class="text-center font-subtitle font-semibold text-zozzo-bleu-fonce text-[clamp(0.65rem,2.8vw,1.1rem)]">Presque un expert</p>
        <div class="flex gap-1 my-2">
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(24px,7vw,60px)] h-[clamp(24px,7vw,60px)]" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(24px,7vw,60px)] h-[clamp(24px,7vw,60px)]" />
        </div>
        <p class="font-title font-semibold text-zozzo-bleu-fonce text-[clamp(0.72rem,3vw,1.2rem)]">Moyen</p>
        <div id="overlay-moyen" class="hidden absolute inset-0 flex-col items-center justify-center rounded-3xl bg-zozzo-overlay-dark">
          <img src="/images/shapes/lock.png" alt="Verrouillé" class="w-[clamp(36px,10vw,56px)] h-[clamp(36px,10vw,56px)] object-contain" />
        </div>
      </div>

      <!-- Difficile — premium -->
      <div
        id="level-difficile"
        class="relative flex flex-col items-center justify-between cursor-pointer overflow-hidden rounded-3xl shadow-md transition hover:scale-105 active:scale-95 bg-zozzo-orange px-[clamp(6px,2vw,16px)] py-[clamp(10px,3.5vw,24px)] min-h-[clamp(160px,45vw,320px)]"
      >
        <p class="text-center font-subtitle font-semibold text-zozzo-bleu-fonce text-[clamp(0.65rem,2.8vw,1.1rem)]">J'ai pas peur du challenge</p>
        <div class="flex gap-[3px] my-2">
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(20px,6vw,52px)] h-[clamp(20px,6vw,52px)]" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(20px,6vw,52px)] h-[clamp(20px,6vw,52px)]" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(20px,6vw,52px)] h-[clamp(20px,6vw,52px)]" />
        </div>
        <p class="font-title font-semibold text-zozzo-bleu-fonce text-[clamp(0.72rem,3vw,1.2rem)]">Difficile</p>
        <div id="overlay-difficile" class="hidden absolute inset-0 flex-col items-center justify-center rounded-3xl bg-zozzo-overlay-dark">
          <img src="/images/shapes/lock.png" alt="Verrouillé" class="w-[clamp(36px,10vw,56px)] h-[clamp(36px,10vw,56px)] object-contain" />
        </div>
      </div>

    </div>
  </div>

  <script>
    // @ts-nocheck
    import { getCurrentUser } from "../../../../lib/backend.js";

    const user      = getCurrentUser();
    const isPremium = user?.abonnement_actif === true;

    if (!isPremium) {
      const ovM = document.getElementById("overlay-moyen");
      const ovD = document.getElementById("overlay-difficile");
      if (ovM) { ovM.classList.remove("hidden"); ovM.style.display = "flex"; }
      if (ovD) { ovD.classList.remove("hidden"); ovD.style.display = "flex"; }
      document.getElementById("level-moyen").addEventListener("click",    () => window.location.href = "/app/premium");
      document.getElementById("level-difficile").addEventListener("click", () => window.location.href = "/app/premium");
    } else {
      document.getElementById("level-moyen").addEventListener("click",    () => window.location.href = "/app/mini-jeux/reconsti/play?level=moyen");
      document.getElementById("level-difficile").addEventListener("click", () => window.location.href = "/app/mini-jeux/reconsti/play?level=difficile");
    }
  </script>

</AppLayout>
