---
// @ts-nocheck
import AppLayout from "../../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Classement" showBack={true} backHref="/app/mini-jeux" pageTitle="Classement">

  <!-- CHARGEMENT -->
  <div id="loading-screen"
    class="flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center gap-3 bg-white">
    <div class="h-10 w-10 animate-spin rounded-full border-4 border-zozzo-bleu-fonce border-t-transparent"></div>
    <p class="font-subtitle text-sm text-gray-400">Chargement…</p>
  </div>

  <!-- CONTENU -->
  <div id="content" class="hidden px-4 pb-20 pt-6 bg-white">

    <!-- Avatar utilisateur connecté + titre -->
    <div class="mb-6 flex items-center gap-4">
      <div id="my-avatar"
        class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-zozzo-beige shadow-sm">
        <span id="my-initiale" class="font-title text-xl text-zozzo-orange">?</span>
        <img id="my-avatar-img" src="" alt="" class="hidden h-full w-full object-cover" />
      </div>
      <div>
        <p class="font-subtitle text-xs font-medium uppercase tracking-wide text-gray-400">Mini-jeu</p>
        <h1 id="jeu-titre" class="font-title text-2xl text-zozzo-orange">Classement</h1>
        <p id="niveau-label" class="text-xs font-medium text-gray-400"></p>
      </div>
    </div>

    <!-- Liste classement -->
    <div id="scores-list" class="space-y-3 max-w-lg mx-auto"></div>

    <!-- Aucun score -->
    <div id="no-score" class="hidden py-12 text-center">
      <p class="font-subtitle text-gray-400">Aucun classement disponible pour le moment.</p>
      <a id="play-link" href="/app/mini-jeux"
        class="mt-5 inline-block rounded-full bg-zozzo-orange px-7 py-3 font-semibold text-white transition hover:opacity-90">
        Jouer maintenant
      </a>
    </div>

  </div>

  <!-- Flèche retour -->
  <a id="back-btn" href="/app/mini-jeux"
    class="fixed bottom-6 right-6 transition hover:scale-110 active:scale-95">
    <svg viewBox="0 0 60 24" class="h-8 w-16" fill="none">
      <line x1="0" y1="12" x2="50" y2="12" stroke="var(--color-zozzo-jaune)" stroke-width="4" stroke-linecap="round"/>
      <polyline points="38,3 54,12 38,21" stroke="var(--color-zozzo-jaune)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  <script>
    // @ts-nocheck
    import {
      getClassement,
      getCurrentUser,
      getCurrentUserWithAvatar,
      getAvatarImageUrl,
      pb,
    } from "../../../lib/backend.js";

    const params = new URLSearchParams(window.location.search);
    const slug   = params.get("slug")   ?? "";
    const niveau = params.get("level")  ?? "";

    // Routes de retour par jeu
    const BACK = {
      "top-chrono": "/app/mini-jeux/top-chrono",
      "relis-tout":  "/app/mini-jeux/relis-tout",
      "reconsti":    "/app/mini-jeux/reconsti",
    };
    const PLAY = {
      "top-chrono": `/app/mini-jeux/top-chrono/play?level=${niveau}`,
      "relis-tout":  `/app/mini-jeux/relis-tout/play?level=${niveau}`,
      "reconsti":    `/app/mini-jeux/reconsti/play?level=${niveau}`,
    };

    // Formater le temps
    function fmt(sec) {
      if (!sec && sec !== 0) return "—";
      const m = Math.floor(sec / 60), s = sec % 60;
      return m > 0 ? `${m} min ${s} s` : `${s} s`;
    }

    // Médaille
    function medal(i) {
      return ["🥇","🥈","🥉"][i] ?? `${i + 1}.`;
    }

    // Avatar HTML
    function avatarHTML(user, size = "h-10 w-10") {
      const avatarRecord = user?.expand?.avatar;
      const url = getAvatarImageUrl(avatarRecord);
      if (url) {
        return `<img src="${url}" alt="${user?.pseudo ?? ""}"
          class="${size} rounded-full object-cover shrink-0"
          onerror="this.style.display='none'" />`;
      }
      const initiale = user?.pseudo?.[0]?.toUpperCase() ?? "?";
      return `<div class="${size} rounded-full bg-zozzo-beige flex items-center justify-center shrink-0 font-title text-zozzo-orange">${initiale}</div>`;
    }

    // Afficher l'avatar de l'utilisateur connecté
    async function afficherMonAvatar() {
      try {
        const me = await getCurrentUserWithAvatar();
        if (!me) return;

        const url = getAvatarImageUrl(me.expand?.avatar);
        if (url) {
          const img = document.getElementById("my-avatar-img");
          img.src = url;
          img.classList.remove("hidden");
          document.getElementById("my-initiale").classList.add("hidden");
        } else {
          document.getElementById("my-initiale").textContent = me.pseudo?.[0]?.toUpperCase() ?? "?";
        }
      } catch { /* ignore */ }
    }

    (async () => {
      try {
        // Mettre à jour les liens retour
        document.getElementById("back-btn").href = BACK[slug] ?? "/app/mini-jeux";
        document.getElementById("play-link").href = PLAY[slug] ?? "/app/mini-jeux";

        // Afficher mon avatar
        afficherMonAvatar();

        // Trouver le jeu par slug
        let jeuId = null, jeuTitre = slug;
        try {
          const jeu = await pb.collection("jeux").getFirstListItem(`slug = "${slug}" && actif = true`);
          jeuId    = jeu?.id ?? null;
          jeuTitre = jeu?.titre ?? slug;
        } catch { /* jeu non trouvé, on continue */ }

        document.getElementById("jeu-titre").textContent = jeuTitre || "Classement";
        document.getElementById("niveau-label").textContent = niveau.replace("_", " ");

        // Charger les scores
        const scores = jeuId ? await getClassement(jeuId, niveau, 10) : [];
        const me     = getCurrentUser();

        document.getElementById("loading-screen").classList.add("hidden");
        document.getElementById("content").classList.remove("hidden");

        if (!scores.length) {
          document.getElementById("no-score").classList.remove("hidden");
          return;
        }

        const list = document.getElementById("scores-list");
        scores.forEach((s, i) => {
          const user      = s.expand?.utilisateur;
          const pseudo    = user?.pseudo || user?.email || "—";
          const isMoi     = user?.id === me?.id;
          const scoreStr  = s.nombre_mots ? `${s.score} / ${s.nombre_mots}` : `${s.score}`;
          const tempsStr  = fmt(s.temps_secondes);

          const row = document.createElement("div");
          row.className = [
            "flex items-center gap-3 rounded-2xl px-4 py-3 shadow-sm transition",
            isMoi
              ? "border-2 border-zozzo-bleu-clair"
              : i % 2 === 0 ? "bg-white border border-gray-100" : "border",
          ].join(" ");
          if (isMoi) {
            row.style.backgroundColor = "var(--color-zozzo-surface-jaune)";
          } else if (i % 2 !== 0) {
            row.style.backgroundColor = "var(--color-zozzo-surface-bleu)";
            row.style.borderColor = "var(--color-zozzo-border-soft-blue)";
          }

          row.innerHTML = `
            <!-- Médaille -->
            <span class="w-8 text-center font-semibold text-lg shrink-0">${medal(i)}</span>
            <!-- Avatar -->
            ${avatarHTML(user, "h-10 w-10")}
            <!-- Infos -->
            <div class="flex-1 min-w-0">
              <p class="font-subtitle text-sm font-bold truncate ${isMoi ? "text-zozzo-bleu-fonce" : "text-zozzo-text"}">
                ${pseudo}${isMoi ? " <span class='text-zozzo-orange font-normal text-xs'>(moi)</span>" : ""}
              </p>
              <p class="text-xs text-gray-400">${scoreStr} · ${tempsStr}</p>
            </div>
            ${isMoi ? `<span class="shrink-0 text-xs font-semibold text-zozzo-bleu-fonce bg-zozzo-bleu-clair/20 px-2 py-0.5 rounded-full">Toi</span>` : ""}
          `;

          list.appendChild(row);
        });

      } catch (err) {
        console.error("[ZOZZO] Classement :", err);
        document.getElementById("loading-screen").innerHTML = `
          <p class="font-subtitle text-sm text-red-500 px-6 text-center">
            Impossible de charger le classement.<br/>
            <span class="text-xs text-gray-400">${err?.message ?? ""}</span>
          </p>
          <a href="/app/mini-jeux" class="mt-4 rounded-full bg-zozzo-orange px-6 py-2 text-sm text-white font-semibold">
            Retour
          </a>`;
      }
    })();
  </script>

</AppLayout>
