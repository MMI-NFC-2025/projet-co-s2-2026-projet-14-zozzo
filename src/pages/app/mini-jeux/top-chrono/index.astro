---
// @ts-nocheck
import AppLayout from "../../../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Top Chrono" showBack={true} backHref="/app/mini-jeux" pageTitle="Top Chrono">

  <div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center px-4 py-8">

    <h2 class="mb-8 text-center font-subtitle text-sm font-medium text-gray-600 sm:text-base">
      Choisi le nombre de mots à trouver
    </h2>

    <!-- 3 cartes côte à côte — responsive -->
    <div class="grid w-full grid-cols-1 gap-4 px-4 sm:grid-cols-3 sm:px-2" style="max-width:min(98vw,700px);">

      <!-- Une partie rapide — 15 mots -->
      <div
        onclick="window.location.href='/app/mini-jeux/top-chrono/play?level=15'"
        class="flex cursor-pointer flex-col items-center justify-between rounded-3xl shadow-md transition hover:scale-105 active:scale-95"
        style="background:var(--color-zozzo-bleu-clair); padding:clamp(10px,3.5vw,24px) clamp(6px,2vw,16px); min-height:clamp(160px,45vw,320px);"
      >
        <p class="text-center font-subtitle font-semibold text-white" style="font-size:clamp(0.65rem,2.8vw,1.1rem);">Une partie rapide</p>
        <img src="/images/shapes/un-etoil-score.svg" alt="★" style="width:clamp(30px,9vw,80px);height:clamp(30px,9vw,80px);margin:8px 0;" />
        <p class="font-title font-semibold text-white" style="font-size:clamp(0.72rem,3vw,1.2rem);">15 mots</p>
      </div>

      <!-- Presque un expert — 30 mots -->
      <!-- Presque un expert — 30 mots -->
      <div
        id="level-30"
        class="relative cursor-pointer overflow-hidden rounded-3xl shadow-md transition hover:scale-105 active:scale-95"
        style="background:var(--color-zozzo-jaune); padding:clamp(10px,3.5vw,24px) clamp(6px,2vw,16px); min-height:clamp(160px,45vw,320px); display:flex; flex-direction:column; align-items:center; justify-content:space-between;"
      >
        <p id="label-30" class="text-center font-subtitle font-semibold" style="color:var(--color-zozzo-bleu-fonce);font-size:clamp(0.65rem,2.8vw,1.1rem);">Presque un expert</p>
        <div style="display:flex;gap:4px;margin:8px 0;">
          <img src="/images/shapes/un-etoil-score.svg" alt="★" style="width:clamp(24px,7vw,60px);height:clamp(24px,7vw,60px);" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" style="width:clamp(24px,7vw,60px);height:clamp(24px,7vw,60px);" />
        </div>
        <p class="font-title font-semibold" style="color:var(--color-zozzo-bleu-fonce);font-size:clamp(0.72rem,3vw,1.2rem);">30 mots</p>
        <!-- Overlay + cadenas (visible si non premium) -->
        <div id="overlay-30" class="hidden absolute inset-0 flex-col items-center justify-center rounded-3xl" style="background:var(--color-zozzo-overlay-dark);">
          <img src="/images/shapes/lock.png" alt="Verrouillé" style="width:clamp(36px,10vw,56px);height:clamp(36px,10vw,56px);object-fit:contain;" />
        </div>
      </div>

      <!-- J'ai pas peur du challenge — 50 mots -->
      <div
        id="level-50"
        class="relative cursor-pointer overflow-hidden rounded-3xl shadow-md transition hover:scale-105 active:scale-95"
        style="background:var(--color-zozzo-orange); padding:clamp(10px,3.5vw,24px) clamp(6px,2vw,16px); min-height:clamp(160px,45vw,320px); display:flex; flex-direction:column; align-items:center; justify-content:space-between;"
      >
        <p id="label-50" class="text-center font-subtitle font-semibold" style="color:var(--color-zozzo-bleu-fonce);font-size:clamp(0.65rem,2.8vw,1.1rem);">J'ai pas peur du challenge</p>
        <div style="display:flex;gap:3px;margin:8px 0;">
          <img src="/images/shapes/un-etoil-score.svg" alt="★" style="width:clamp(20px,6vw,52px);height:clamp(20px,6vw,52px);" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" style="width:clamp(20px,6vw,52px);height:clamp(20px,6vw,52px);" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" style="width:clamp(20px,6vw,52px);height:clamp(20px,6vw,52px);" />
        </div>
        <p class="font-title font-semibold" style="color:var(--color-zozzo-bleu-fonce);font-size:clamp(0.72rem,3vw,1.2rem);">50 mots</p>
        <!-- Overlay + cadenas (visible si non premium) -->
        <div id="overlay-50" class="hidden absolute inset-0 flex-col items-center justify-center rounded-3xl" style="background:var(--color-zozzo-overlay-dark);">
          <img src="/images/shapes/lock.png" alt="Verrouillé" style="width:clamp(36px,10vw,56px);height:clamp(36px,10vw,56px);object-fit:contain;" />
        </div>
      </div>

    </div>
  </div>

  <script>
    // @ts-nocheck
    import { getCurrentUser } from "../../../../lib/backend.js";

    const user      = getCurrentUser();
    const isPremium = user?.abonnement_actif === true;

    const card30   = document.getElementById("level-30");
    const card50   = document.getElementById("level-50");
    const label30  = document.getElementById("label-30");
    const label50  = document.getElementById("label-50");

    if (!isPremium) {
      // Afficher overlay + cadenas
      const ov30 = document.getElementById("overlay-30");
      const ov50 = document.getElementById("overlay-50");
      if (ov30) { ov30.classList.remove("hidden"); ov30.style.display = "flex"; }
      if (ov50) { ov50.classList.remove("hidden"); ov50.style.display = "flex"; }
      card30.addEventListener("click", () => window.location.href = "/app/premium");
      card50.addEventListener("click", () => window.location.href = "/app/premium");
    } else {
      card30.addEventListener("click", () => window.location.href = "/app/mini-jeux/top-chrono/play?level=30");
      card50.addEventListener("click", () => window.location.href = "/app/mini-jeux/top-chrono/play?level=50");
    }
  </script>

</AppLayout>
