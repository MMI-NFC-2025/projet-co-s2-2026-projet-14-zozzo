---
// @ts-nocheck
import AppLayout from "../../../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Top Chrono" showBack={true} backHref="/app/mini-jeux" pageTitle="Top Chrono">

  <div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center px-4 py-8">

    <h2 class="mb-8 text-center font-subtitle text-sm font-medium text-gray-600 sm:text-base">
      Choisi le nombre de mots à trouver
    </h2>

    <!-- 3 cartes côte à côte — responsive -->
    <div class="grid w-full grid-cols-1 gap-4 px-4 sm:grid-cols-3 sm:px-2 max-w-[min(98vw,700px)]">

      <!-- Une partie rapide — 15 mots -->
      <div
        onclick="window.location.href='/app/mini-jeux/top-chrono/play?level=15'"
        class="flex cursor-pointer flex-col items-center justify-between rounded-3xl shadow-md transition hover:scale-105 active:scale-95 bg-zozzo-bleu-clair px-[clamp(6px,2vw,16px)] py-[clamp(10px,3.5vw,24px)] min-h-[clamp(160px,45vw,320px)]"
      >
        <p class="text-center font-subtitle font-semibold text-white text-[clamp(0.65rem,2.8vw,1.1rem)]">Une partie rapide</p>
        <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(30px,9vw,80px)] h-[clamp(30px,9vw,80px)] my-2" />
        <p class="font-title font-semibold text-white text-[clamp(0.72rem,3vw,1.2rem)]">15 mots</p>
      </div>

      <!-- Presque un expert — 30 mots -->
      <div
        id="level-30"
        class="relative flex flex-col items-center justify-between cursor-pointer overflow-hidden rounded-3xl shadow-md transition hover:scale-105 active:scale-95 bg-zozzo-jaune px-[clamp(6px,2vw,16px)] py-[clamp(10px,3.5vw,24px)] min-h-[clamp(160px,45vw,320px)]"
      >
        <p id="label-30" class="text-center font-subtitle font-semibold text-zozzo-bleu-fonce text-[clamp(0.65rem,2.8vw,1.1rem)]">Presque un expert</p>
        <div class="flex gap-1 my-2">
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(24px,7vw,60px)] h-[clamp(24px,7vw,60px)]" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(24px,7vw,60px)] h-[clamp(24px,7vw,60px)]" />
        </div>
        <p class="font-title font-semibold text-zozzo-bleu-fonce text-[clamp(0.72rem,3vw,1.2rem)]">30 mots</p>
        <!-- Overlay + cadenas (visible si non premium) -->
        <div id="overlay-30" class="hidden absolute inset-0 flex-col items-center justify-center rounded-3xl bg-zozzo-overlay-dark">
          <img src="/images/shapes/lock.png" alt="Verrouillé" class="w-[clamp(36px,10vw,56px)] h-[clamp(36px,10vw,56px)] object-contain" />
        </div>
      </div>

      <!-- J'ai pas peur du challenge — 50 mots -->
      <div
        id="level-50"
        class="relative flex flex-col items-center justify-between cursor-pointer overflow-hidden rounded-3xl shadow-md transition hover:scale-105 active:scale-95 bg-zozzo-orange px-[clamp(6px,2vw,16px)] py-[clamp(10px,3.5vw,24px)] min-h-[clamp(160px,45vw,320px)]"
      >
        <p id="label-50" class="text-center font-subtitle font-semibold text-zozzo-bleu-fonce text-[clamp(0.65rem,2.8vw,1.1rem)]">J'ai pas peur du challenge</p>
        <div class="flex gap-[3px] my-2">
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(20px,6vw,52px)] h-[clamp(20px,6vw,52px)]" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(20px,6vw,52px)] h-[clamp(20px,6vw,52px)]" />
          <img src="/images/shapes/un-etoil-score.svg" alt="★" class="w-[clamp(20px,6vw,52px)] h-[clamp(20px,6vw,52px)]" />
        </div>
        <p class="font-title font-semibold text-zozzo-bleu-fonce text-[clamp(0.72rem,3vw,1.2rem)]">50 mots</p>
        <!-- Overlay + cadenas (visible si non premium) -->
        <div id="overlay-50" class="hidden absolute inset-0 flex-col items-center justify-center rounded-3xl bg-zozzo-overlay-dark">
          <img src="/images/shapes/lock.png" alt="Verrouillé" class="w-[clamp(36px,10vw,56px)] h-[clamp(36px,10vw,56px)] object-contain" />
        </div>
      </div>

    </div>
  </div>

  <script>
    // @ts-nocheck
    import { getCurrentUser } from "../../../../lib/backend.js";

    const user      = getCurrentUser();
    const isPremium = user?.abonnement_actif === true;

    const card30   = document.getElementById("level-30");
    const card50   = document.getElementById("level-50");
    const label30  = document.getElementById("label-30");
    const label50  = document.getElementById("label-50");

    if (!isPremium) {
      // Afficher overlay + cadenas
      const ov30 = document.getElementById("overlay-30");
      const ov50 = document.getElementById("overlay-50");
      if (ov30) { ov30.classList.remove("hidden"); ov30.style.display = "flex"; }
      if (ov50) { ov50.classList.remove("hidden"); ov50.style.display = "flex"; }
      card30.addEventListener("click", () => window.location.href = "/app/premium");
      card50.addEventListener("click", () => window.location.href = "/app/premium");
    } else {
      card30.addEventListener("click", () => window.location.href = "/app/mini-jeux/top-chrono/play?level=30");
      card50.addEventListener("click", () => window.location.href = "/app/mini-jeux/top-chrono/play?level=50");
    }
  </script>

</AppLayout>
