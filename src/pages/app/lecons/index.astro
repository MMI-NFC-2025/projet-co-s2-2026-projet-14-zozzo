---
// @ts-nocheck
import AppLayout from "../../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Leçons" showBack={true} backHref="/app" pageTitle="Leçons">

  <!-- Conteneur avec fond en repeat-y, hauteur 250vh pour que les cartes soient bien espacées -->
  <div class="relative w-full bg-[url('/images/shapes/bg-lecon-menu.png')] bg-no-repeat bg-[length:100%_auto] min-h-[250vh]">

    <!-- Overlay avec les cartes positionnées -->
    <div id="lecons-overlay" class="absolute inset-0">

      <!-- Chargement -->
      <div id="lecons-loading" class="flex flex-col items-center pt-16">
        <div class="mb-3 h-10 w-10 animate-spin rounded-full border-4 border-white border-t-transparent"></div>
        <p class="font-subtitle text-white drop-shadow">Chargement…</p>
      </div>

      <!-- Erreur -->
      <div id="lecons-error" class="hidden px-6 pt-16">
        <div class="mx-auto max-w-xs rounded-3xl bg-white/95 p-5 shadow-lg">
          <p class="font-semibold text-red-600">Erreur de chargement</p>
          <p id="lecons-error-msg" class="mt-1 break-all text-xs text-gray-600"></p>
        </div>
      </div>

      <!-- Cartes générées en JS avec position absolue -->

    </div>

    <!-- Bouton retour jaune fixé en bas à gauche -->
    <a
      href="/app"
      class="fixed bottom-6 left-5 z-50 flex h-12 w-12 items-center justify-center rounded-full shadow-lg transition hover:scale-105 active:scale-95 bg-zozzo-jaune"
      aria-label="Retour"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7 fill-zozzo-bleu-fonce"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
    </a>
  </div>

  <script>
    // @ts-nocheck
    import { getLecons, getCurrentUser, getProgressionByUser, getLeconImageUrl } from "../../../lib/backend.js";

    const loadingEl = document.getElementById("lecons-loading");
    const errorEl   = document.getElementById("lecons-error");
    const overlay   = document.getElementById("lecons-overlay");

    // Couleur de fond par ordre de leçon
    const COLORS = [
      "var(--color-zozzo-lilas)",
      "var(--color-zozzo-jaune-vif)",
      "var(--color-zozzo-rose-clair)",
      "var(--color-zozzo-vert-clair)",
    ];

    // Positions sur le chemin — % relatif à 250vh de hauteur
    const POSITIONS = [
      { top: "4%",  left: "55%", right: "auto" }, // ordre 1 — Les bases
      { top: "27%", left: "15%", right: "auto" }, // ordre 2 — La politesse
      { top: "52%", left: "47%", right: "auto" }, // ordre 3 — Les animaux
      { top: "74%", left: "auto", right: "15%" }, // ordre 4 — Magicienne
    ];

    function estDebloquee(lecon, toutes, progressions) {
      if (lecon.ordre === 1) return true;
      const prev = toutes.find(l => l.ordre === lecon.ordre - 1);
      if (!prev) return true;
      return progressions.some(p => p.lecon === prev.id && p.termine === true);
    }

    function estPremium(lecon, user) {
      return (lecon.ordre === 4 || lecon.titre?.toLowerCase().includes("magicienne"))
             && !user?.abonnement_actif;
    }

    function creerCarte(lecon, pos, bloquee, premiumBloquee) {
      const imgUrl  = getLeconImageUrl(lecon);
      // Toujours utiliser la couleur de la leçon — l'overlay gère l'effet verrouillé
      const bgColor = COLORS[(lecon.ordre - 1) % COLORS.length] ?? "var(--color-zozzo-violet)";

      const card = document.createElement("div");
      // Position absolue sur le fond — taille via CSS responsive (.lecon-card)
      card.className             = "lecon-card";
      card.style.top             = pos.top;
      card.style.left            = pos.left;
      card.style.right           = pos.right;
      card.style.backgroundColor = bgColor;

      // Titre + image via classes CSS globales
      const titreHTML    = `<p class="lecon-titre">${lecon.titre}</p>`;
      const imgInnerHTML = imgUrl
        ? `<img class="lecon-img" src="${imgUrl}" alt="${lecon.titre}" onerror="this.style.display='none'" />`
        : "";

      if (bloquee) {
        card.innerHTML = `
          ${titreHTML}
          ${imgInnerHTML}
          <div style="position:absolute;inset:0;background:var(--color-zozzo-overlay-neutral);border-radius:inherit;"></div>
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:2;">
            <img src="/images/shapes/lock.png" alt="Verrouillé" style="width:clamp(36px,9vw,52px);height:clamp(36px,9vw,52px);object-fit:contain;" />
          </div>`;

        card.addEventListener("click", () => {
          if (premiumBloquee) window.location.href = "/app/premium";
        });
      } else {
        card.innerHTML = `${titreHTML}${imgInnerHTML}`;

        card.addEventListener("mouseover",  () => { card.style.transform = "scale(1.05)"; });
        card.addEventListener("mouseleave", () => { card.style.transform = "scale(1)"; });
        card.addEventListener("click", () => { window.location.href = `/app/lecons/detail?id=${lecon.id}`; });
      }

      return card;
    }

    (async () => {
      try {
        const user = getCurrentUser();
        const lecons = await getLecons(); // ASC ordre

        let progressions = [];
        try {
          if (user) progressions = await getProgressionByUser(user.id);
        } catch { /* non bloquant */ }

        loadingEl.style.display = "none";

        if (!lecons.length) {
          overlay.innerHTML += `<div style="margin:40px auto;max-width:280px;background:var(--color-zozzo-overlay-light-fort);border-radius:20px;padding:20px;text-align:center;"><p>Aucune leçon disponible.</p></div>`;
          return;
        }

        // Affichage ordre 1 en bas → ordre N en haut (comme la maquette)
        lecons.forEach((lecon) => {
          const idx           = lecon.ordre - 1; // 0-based
          const pos           = POSITIONS[idx] ?? POSITIONS[POSITIONS.length - 1];
          const debloquee     = estDebloquee(lecon, lecons, progressions);
          const premiumBlock  = estPremium(lecon, user);
          const bloquee       = !debloquee || premiumBlock;
          overlay.appendChild(creerCarte(lecon, pos, bloquee, premiumBlock));
        });

      } catch (err) {
        console.error("[ZOZZO] Leçons :", err);
        loadingEl.style.display = "none";
        errorEl.classList.remove("hidden");
        const msgEl = document.getElementById("lecons-error-msg");
        if (msgEl) msgEl.textContent = `${err?.status ? "Status " + err.status + " — " : ""}${err?.message ?? String(err)}`;
      }
    })();
  </script>

</AppLayout>
