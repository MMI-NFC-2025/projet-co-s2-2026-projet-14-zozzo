---
// @ts-nocheck
import AppLayout from "../../../layouts/AppLayout.astro";
---

<AppLayout title="ZOZZO | Quiz" showBack={true} backHref="/app/lecons" pageTitle="">

  <!-- CHARGEMENT ──────────────────────────────────────────────────── -->
  <div id="loading-screen"
    class="flex min-h-[calc(100dvh-4rem)] flex-col items-center justify-center gap-4"
    style="background:var(--color-zozzo-surface-rose);">
    <div class="h-12 w-12 animate-spin rounded-full border-4 border-t-transparent"
      style="border-color:var(--color-zozzo-bleu-fonce) transparent var(--color-zozzo-bleu-fonce) var(--color-zozzo-bleu-fonce);"></div>
    <p class="font-subtitle text-gray-400">Chargement du quiz…</p>
  </div>

  <!-- QUIZ ────────────────────────────────────────────────────────── -->
  <div id="quiz-screen"
    class="hidden flex-col min-h-[calc(100dvh-4rem)]"
    style="background:var(--color-zozzo-surface-rose);">

    <!-- Titre + barre de progression -->
    <div class="shrink-0 px-5 pt-5 text-center">
      <h1 id="lecon-titre" class="font-title text-xl text-zozzo-text"></h1>
      <p id="prog-label" class="mt-1 text-xs font-medium text-gray-400">Signe 1 / ?</p>
      <div class="mx-auto mt-2 h-2 max-w-xs overflow-hidden rounded-full bg-gray-200">
        <div id="prog-bar" class="h-full rounded-full transition-all duration-500"
          style="width:0%;background:var(--color-zozzo-bleu-fonce);"></div>
      </div>
    </div>

    <!-- Signe : vidéo ou image ───────────────────────────────────── -->
    <div class="flex flex-1 items-center justify-center px-6 py-3">
      <div id="signe-container"
        class="relative flex w-full items-center justify-center overflow-hidden rounded-3xl shadow-md"
        style="aspect-ratio:4/3; max-width:min(90vw, 480px);"
        style="background:var(--color-zozzo-surface-violet);">

        <!-- Vidéo du signe -->
        <video id="signe-video"
          class="hidden h-full w-full object-contain"
          autoplay muted loop playsinline controls>
        </video>

        <!-- Image du signe -->
        <img id="signe-img" src="" alt="Signe LSF"
          class="hidden h-full w-full object-contain p-2" />

        <!-- Placeholder -->
        <div id="signe-ph" class="flex flex-col items-center gap-1">
          <span class="font-title text-4xl" style="color:var(--color-zozzo-bleu-fonce);">?</span>
          <span class="text-sm text-gray-400">Chargement…</span>
        </div>

        <!-- ZOZZO contente (bonne réponse) -->
        <div id="zozzo-feedback"
          class="absolute inset-0 hidden items-center justify-center rounded-3xl"
          style="background:var(--color-zozzo-success-overlay-fort);">
          <img src="/images/about/zozzo-bon-reponse.png" alt="Bravo !"
            class="h-4/5 w-4/5 object-contain anim-bounce" />
        </div>

        <!-- ZOZZO triste (mauvaise réponse) -->
        <div id="zozzo-mauvaise"
          class="absolute inset-0 hidden items-center justify-center rounded-3xl"
          style="background:var(--color-zozzo-danger-overlay);">
          <img src="/images/about/mouvaise-reponse.png" alt="Oups !"
            class="h-4/5 w-4/5 object-contain anim-bounce" />
        </div>
      </div>
    </div>

    <!-- Question -->
    <p class="shrink-0 px-4 text-center text-sm font-semibold text-gray-500 sm:text-base">
      Quel est ce signe ?
    </p>

    <!-- Boutons réponses 2 × 2 -->
    <div id="answers-grid"
      class="shrink-0 grid grid-cols-2 gap-3 px-5 py-5 sm:px-10">
    </div>
  </div>

  <!-- RÉSULTAT ─────────────────────────────────────────────────────── -->
  <div id="end-screen"
    class="hidden flex-col items-center justify-center min-h-[calc(100dvh-4rem)] px-8 py-6 text-center"
    style="background:var(--color-zozzo-surface-rose);">

    <!-- ZOZZO contente -->
    <img src="/images/about/zozzo-bon-reponse.png" alt="Zozzo" class="mb-2 w-48 max-w-[55vw] h-auto sm:w-56 md:w-64" />

    <!-- Bravo ! -->
    <h1 class="font-title text-3xl text-zozzo-orange">Bravo !</h1>

    <!-- Étoiles -->
    <div id="stars-row" class="my-4 flex items-center justify-center gap-3"></div>

    <!-- Carte Score + Temps -->
    <div class="w-full max-w-xs space-y-4">

      <div class="flex items-center justify-between">
        <span class="font-subtitle text-sm font-semibold text-zozzo-bleu-fonce">Score :</span>
        <span id="score-txt" class="font-title text-2xl text-zozzo-text"></span>
      </div>

      <div class="flex items-center justify-between">
        <span class="font-subtitle text-sm font-semibold text-zozzo-bleu-fonce">Temps :</span>
        <span id="temps-txt" class="font-title text-2xl text-zozzo-text"></span>
      </div>

    </div>

    <!-- Élément caché (garde la compatibilité JS) -->
    <p id="details-txt" class="hidden"></p>

    <!-- Flèche jaune bas droite -->
    <a href="/app/lecons"
      class="fixed bottom-6 right-6 transition hover:scale-110 active:scale-95"
      aria-label="Continuer"
    >
      <svg viewBox="0 0 24 24" class="h-12 w-12 drop-shadow-md" fill="var(--color-zozzo-jaune)"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
    </a>
  </div>

  <script>
    // @ts-nocheck
    import { getLeconById, getSigneImageUrl, getCurrentUser, saveProgression, pb } from "../../../lib/backend.js";

    // ── Paramètre URL ────────────────────────────────────────────────
    const leconId = new URLSearchParams(window.location.search).get("id");
    if (!leconId) { window.location.href = "/app/lecons"; }

    // ── État quiz ────────────────────────────────────────────────────
    let signes    = [];
    let idx       = 0;
    let score     = 0;
    let bonnes    = 0;
    let mauvaises = 0;
    let answered  = false;
    let startTime = null;

    // ── DOM ──────────────────────────────────────────────────────────
    const $  = id => document.getElementById(id);
    const loadingScreen = $("loading-screen");
    const quizScreen    = $("quiz-screen");
    const endScreen     = $("end-screen");
    const leconTitre    = $("lecon-titre");
    const progLabel     = $("prog-label");
    const progBar       = $("prog-bar");
    const signeVideo    = $("signe-video");
    const signeImg      = $("signe-img");
    const signePh       = $("signe-ph");
    const zozzoFeedback  = $("zozzo-feedback");
    const zozzoMauvaise  = $("zozzo-mauvaise");
    const answersGrid    = $("answers-grid");
    const starsRow      = $("stars-row");
    const scoreTxt      = $("score-txt");
    const detailsTxt    = $("details-txt");

    // ── Construire l'URL vidéo du signe ─────────────────────────────
    // Gère video_url (texte) et video (fichier PocketBase)
    function getVideoUrl(signe) {
      if (signe.video_url) return signe.video_url;
      if (signe.video)     return pb.files.getURL(signe, signe.video);
      return null;
    }

    // ── Afficher vidéo OU image du signe ────────────────────────────
    function afficherSigne(signe) {
      signeVideo.classList.add("hidden");
      signeImg.classList.add("hidden");
      signePh.classList.add("hidden");
      zozzoFeedback.classList.add("hidden");
      zozzoFeedback.classList.remove("flex");
      zozzoMauvaise.classList.add("hidden");
      zozzoMauvaise.classList.remove("flex");

      if (!signe) { signePh.classList.remove("hidden"); return; }

      const videoUrl = getVideoUrl(signe);
      if (videoUrl) {
        signeVideo.src = videoUrl;
        signeVideo.load();
        signeVideo.classList.remove("hidden");
        return;
      }

      const imgUrl = getSigneImageUrl(signe);
      if (imgUrl) {
        signeImg.src = imgUrl;
        signeImg.classList.remove("hidden");
      } else {
        signePh.querySelector("span:first-child").textContent = signe.mot ?? "?";
        signePh.querySelector("span:last-child").textContent  = "";
        signePh.classList.remove("hidden");
      }
    }

    // ── Générer 3 mauvaises réponses ─────────────────────────────────
    // Priorité aux autres signes de la leçon, fallback sur collection complète
    async function getMauvaisesReponses(signeCorrect) {
      const autres = signes.filter(s => s.id !== signeCorrect.id && s.mot);

      if (autres.length >= 3) {
        return autres.sort(() => Math.random() - 0.5).slice(0, 3).map(s => s.mot);
      }

      // Pas assez de signes dans la leçon → compléter depuis la collection complète
      try {
        const tous = await pb.collection("signes").getFullList({ fields: "id,mot" });
        const idsLecon = new Set(signes.map(s => s.id));
        const extras = tous
          .filter(s => !idsLecon.has(s.id) && s.mot)
          .sort(() => Math.random() - 0.5);

        const pool = [...autres, ...extras];
        return pool.slice(0, 3).map(s => s.mot);
      } catch {
        return autres.slice(0, 3).map(s => s.mot);
      }
    }

    // ── Afficher une question ────────────────────────────────────────
    async function afficherQuestion(index) {
      // Démarrer le chrono à la première question
      if (index === 0) startTime = Date.now();

      answered = false;
      const signe = signes[index];
      const total = signes.length;

      progLabel.textContent = `Signe ${index + 1} / ${total}`;
      progBar.style.width   = `${Math.round((index / total) * 100)}%`;

      afficherSigne(signe);

      // Construire les 4 choix mélangés
      const mauvaises3 = await getMauvaisesReponses(signe);
      const choix = [signe.mot, ...mauvaises3].filter(Boolean)
        .sort(() => Math.random() - 0.5);

      answersGrid.innerHTML = "";
      choix.forEach(rep => {
        const btn = document.createElement("button");
        btn.textContent            = rep;
        btn.className              = "w-full rounded-full py-4 px-3 font-subtitle text-base font-semibold shadow-sm transition duration-200 active:scale-95";
        btn.style.backgroundColor  = "var(--color-zozzo-beige)";
        btn.style.color            = "var(--color-zozzo-text)";
        btn.addEventListener("click", () => {
          if (answered) return;
          answered = true;
          reagir(rep === signe.mot, btn, signe.mot);
        });
        answersGrid.appendChild(btn);
      });
    }

    // ── Bonne / mauvaise réponse ─────────────────────────────────────
    function reagir(correct, clicked, bonneReponse) {
      answersGrid.querySelectorAll("button").forEach(btn => {
        btn.disabled = true;
        if (btn.textContent === bonneReponse) {
          btn.style.backgroundColor = "var(--color-zozzo-success)";
          btn.style.color           = "var(--color-zozzo-bg)";
          btn.style.opacity         = "1";
        } else {
          btn.style.opacity = "0.45";
        }
      });

      if (correct) {
        score++;
        bonnes++;
        clicked.style.backgroundColor = "var(--color-zozzo-success)";
        clicked.style.color           = "var(--color-zozzo-bg)";
        clicked.style.opacity         = "1";
        zozzoFeedback.classList.remove("hidden");
        zozzoFeedback.classList.add("flex");
      } else {
        mauvaises++;
        clicked.style.backgroundColor = "var(--color-zozzo-danger)";
        clicked.style.color           = "var(--color-zozzo-bg)";
        clicked.style.opacity         = "1";
        clicked.classList.add("anim-shake");
        zozzoMauvaise.classList.remove("hidden");
        zozzoMauvaise.classList.add("flex");
      }

      setTimeout(async () => {
        idx++;
        if (idx < signes.length) await afficherQuestion(idx);
        else                      afficherResultat();
      }, 1500);
    }

    // ── Écran résultat ───────────────────────────────────────────────
    async function afficherResultat() {
      progBar.style.width = "100%";
      quizScreen.classList.add("hidden");
      endScreen.classList.remove("hidden");
      endScreen.classList.add("flex");

      const total   = signes.length || 1;
      const pct     = Math.round((score / total) * 100);
      const etoiles = pct >= 80 ? 3 : pct >= 50 ? 2 : 1;

      starsRow.innerHTML = Array.from({ length: etoiles }, () =>
        `<img src="/images/shapes/un-etoil-score.svg" alt="étoile" style="width:52px;height:52px;display:inline-block;" />`
      ).join("");
      // Calcul du temps écoulé
      const elapsed = startTime ? Math.round((Date.now() - startTime) / 1000) : 0;
      const mins    = Math.floor(elapsed / 60);
      const secs    = elapsed % 60;
      const tempsStr = mins > 0 ? `${mins} min${mins > 1 ? "s" : ""} ${secs} s` : `${secs} s`;

      scoreTxt.textContent      = `${score}/ ${total} mots`;
      $("temps-txt").textContent = tempsStr;

      const user = getCurrentUser();
      if (user) {
        try {
          await saveProgression({ utilisateur: user.id, lecon: leconId, termine: true, etoiles, score: pct });
        } catch (e) { console.warn("[ZOZZO] progression :", e); }
      }
    }

    // ── Démarrage ────────────────────────────────────────────────────
    (async () => {
      try {
        // 1. Charger la leçon
        const lecon = await getLeconById(leconId);
        leconTitre.textContent = lecon.titre ?? "Quiz";

        // 2. Charger les signes de la leçon via lecon_signes
        const leconSignesData = await pb.collection("lecon_signes").getFullList({
          filter: `lecon = "${leconId}"`,
          expand: "signe",
          sort: "ordre",
        });

        signes = leconSignesData
          .map(ls => ls.expand?.signe)
          .filter(s => s && s.mot); // garder uniquement les signes avec un mot

        loadingScreen.classList.add("hidden");

        if (!signes.length) {
          quizScreen.classList.remove("hidden");
          quizScreen.classList.add("flex");
          answersGrid.innerHTML = `
            <p class="col-span-2 py-10 text-center font-subtitle text-gray-400">
              Aucun signe trouvé dans cette leçon.<br/>
              <span class="text-xs">Vérifie la collection <code>lecon_signes</code> dans PocketBase.</span>
            </p>`;
          progLabel.textContent = "—";
          return;
        }

        // 3. Lancer le quiz
        quizScreen.classList.remove("hidden");
        quizScreen.classList.add("flex");
        await afficherQuestion(0);

      } catch (err) {
        console.error("[ZOZZO] quiz :", err);
        loadingScreen.innerHTML = `
          <div class="text-center px-6">
            <p class="font-subtitle font-semibold text-red-500">Impossible de charger le quiz</p>
            <p class="mt-1 text-xs text-gray-400">${err?.message ?? String(err)}</p>
            <a href="/app/lecons" class="mt-4 inline-block rounded-full bg-zozzo-orange px-6 py-3 text-sm font-semibold text-white">
              Retour aux leçons
            </a>
          </div>`;
      }
    })();
  </script>

</AppLayout>
