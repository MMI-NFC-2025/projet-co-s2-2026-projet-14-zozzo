---
const desktopNavigation = [
  { href: "/", label: "Accueil" },
  { href: "/fonctionnalites", label: "Fonctionnalités" },
  { href: "/apropos", label: "À propos" },
  { href: "/contact", label: "Contact" },
];

const mobileNavigation = [...desktopNavigation];
---

<header class="sticky top-0 z-50 w-full">
  <div
    class="bg-zozzo-orange flex items-center justify-between px-6 py-3 shadow-[0_6px_18px_rgba(0,0,0,0.12)] md:px-10"
  >
    <a href="/" aria-label="Accueil ZOZZO">
      <img
        src="/images/logo-zozzo.svg"
        alt="ZOZZO"
        class="h-8 w-auto md:h-10"
      />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <nav class="flex items-center gap-8" aria-label="Navigation principale">
        {
          desktopNavigation.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-black transition hover:opacity-80"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Bouton auth desktop : mis à jour en JS selon l'état de connexion -->
      <a
        id="auth-btn-desktop"
        href="/login"
        class="rounded-full px-5 py-2 text-sm font-semibold transition hover:opacity-90"
        style="background-color: var(--color-zozzo-jaune); color: var(--color-zozzo-orange);"
      >
        Connexion
      </a>
    </div>

    <button
      id="menu-btn"
      class="group relative z-50 flex h-9 w-9 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        class="block h-0.5 w-7 rounded-full bg-white transition-transform duration-300 group-aria-expanded:translate-y-2 group-aria-expanded:rotate-45"
      ></span>
      <span
        class="block h-0.5 w-7 rounded-full bg-white transition-opacity duration-300 group-aria-expanded:opacity-0"
      ></span>
      <span
        class="block h-0.5 w-7 rounded-full bg-white transition-transform duration-300 group-aria-expanded:-translate-y-2 group-aria-expanded:-rotate-45"
      ></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="mobile-overlay overflow-y-auto md:hidden"
    aria-hidden="true"
    data-open="false"
  >
    <nav class="flex flex-col gap-6 px-6 pt-20 pb-10 sm:px-10 sm:pt-24">
      {
        mobileNavigation.map((item) => (
          <a
            href={item.href}
            class="text-lg font-semibold text-white transition hover:opacity-80 sm:text-xl"
          >
            {item.label}
          </a>
        ))
      }

      <!-- Bouton auth mobile : mis à jour en JS selon l'état de connexion -->
      <a
        id="auth-btn-mobile"
        href="/login"
        class="mt-4 w-fit rounded-full px-6 py-3 font-semibold"
        style="background-color: var(--color-zozzo-jaune); color: var(--color-zozzo-orange);"
      >
        Connexion
      </a>
    </nav>
  </div>
</header>

<script>
  // @ts-nocheck
  const toggle = document.querySelector("#menu-btn");
  const menu = document.querySelector("#mobile-menu");
  const page = document.body;

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      const nextState = String(!isOpen);
      toggle.setAttribute("aria-expanded", nextState);
      menu.setAttribute("aria-hidden", String(isOpen));
      menu.setAttribute("data-open", String(!isOpen));
      page.classList.toggle("noscroll", !isOpen);
    });
  }

  // ── Bouton auth : adapte selon connexion PocketBase ──
  import { isLoggedIn, getCurrentUser, logout } from "../lib/pocketbase.js";

  const btnDesktop = document.getElementById("auth-btn-desktop");
  const btnMobile = document.getElementById("auth-btn-mobile");

  if (isLoggedIn()) {
    const user = getCurrentUser();
    const label = user?.pseudo || "Mon espace";

    // Transformer en bouton "Mon espace" → /app
    [btnDesktop, btnMobile].forEach((btn) => {
      if (!btn) return;
      btn.textContent = label;
      btn.setAttribute("href", "/app");
    });

    // Ajouter un bouton déconnexion juste après (desktop)
    if (btnDesktop) {
      const logoutBtn = document.createElement("button");
      logoutBtn.textContent = "Déconnexion";
      logoutBtn.className = "rounded-full px-5 py-2 text-sm font-semibold text-white transition hover:bg-white/20";
      logoutBtn.addEventListener("click", () => {
        logout();
        window.location.href = "/login";
      });
      btnDesktop.insertAdjacentElement("afterend", logoutBtn);
    }
  }
</script>
